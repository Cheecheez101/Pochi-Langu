NODE_ENV=development
APP_NAME=Pochi Langu
APP_PORT=4000
APP_BASE_URL=http://localhost:4000
API_VERSION=v1
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d
POSTGRES_HOST=localhost
POSTGRES_PORT=15432
POSTGRES_DB=pochi_langu
POSTGRES_USER=pochi_langu_app
POSTGRES_PASSWORD=replace-with-admin-password
POSTGRES_ADMIN_USER=pochi_langu
POSTGRES_ADMIN_PASSWORD=replace-with-admin-password
POSTGRES_MIGRATION_ROLE=pochi_langu_migration
POSTGRES_MIGRATION_PASSWORD=replace-with-migration-password
POSTGRES_APP_ROLE=pochi_langu_app
POSTGRES_APP_PASSWORD=replace-with-app-password
POSTGRES_CA_CERT=
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
